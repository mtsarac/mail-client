# Copy to .env and fill in real values. Never commit .env.

# Docker Compose only (docker-compose.prod.yml): configures the postgres container and
# is interpolated into ConnectionStrings__Default for the api/migrate services. Not read
# by the app directly. See backend/docs/DOCKER.md.
# POSTGRES_USER=mailclient
# POSTGRES_PASSWORD=change-me-long-random-db-password
# POSTGRES_DB=mailclient_v2
# DATAPROTECTION_CERT_HOST_PATH=./secrets/dataprotection.pfx

ConnectionStrings__Default=Host=localhost;Port=5432;Database=mailclient_v2;Username=postgres;Password=change-me
Jwt__Issuer=MailClient
Jwt__Audience=MailClient
Jwt__Key=change-me-at-least-32-characters-long-random-secret
Jwt__AccessTokenMinutes=15
DataProtection__KeyPath=./data/protection-keys
# DataProtection__CertificatePath=./secrets/dataprotection.pfx
# Firebase__ProjectId=
# Firebase__CredentialsPath=
# Proxy__KnownProxies__0=
# Proxy__KnownNetworks__0=

# OAuth2 provider authentication (Authorization Code + PKCE). Leave unset to disable OAuth for a provider.
# OAuth__Google__ClientId=
# OAuth__Google__ClientSecret=
# OAuth__Google__RedirectUris__0=com.mailclient.app:/oauth/callback
# OAuth__Microsoft__ClientId=
# OAuth__Microsoft__ClientSecret=
# OAuth__Microsoft__Tenant=organizations
# OAuth__Microsoft__RedirectUris__0=com.mailclient.app:/oauth/callback
# OAuth__StateLifetimeMinutes=10

# Deployment-level runtime settings management API. Keep disabled unless protected by a strong secret.
# Management__Enabled=false
# Management__ApiKey=change-me-long-random-management-secret

# Observability (static deployment configuration; never stored in runtime settings). See backend/OBSERVABILITY.md.
# Observability__ServiceName=mail-client
# Observability__Tracing__Enabled=true
# Observability__Metrics__Enabled=true
# Observability__Otlp__Enabled=false
# Observability__Otlp__Endpoint=http://otel-collector:4317
# Observability__Otlp__Protocol=Grpc
# Standard OpenTelemetry variables also apply. Treat headers as secrets.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer change-me
# Prometheus scrape endpoint (/metrics, prerelease exporter). Restrict access at the proxy/network layer.
# Observability__Prometheus__Enabled=false
# Log file retention
# Observability__Logs__App__RetainedFileCountLimit=14
# Observability__Logs__App__FileSizeLimitBytes=104857600
# Observability__Logs__Http__RetainedFileCountLimit=7
# Observability__Logs__Http__FileSizeLimitBytes=104857600

# Attachment storage (static deployment configuration). Local is single-instance or a shared volume;
# S3 is required for multiple instances without shared storage. Credentials are never stored in the
# database or runtime settings; leave the key pair empty to use the ambient AWS credential chain.
# Storage__Provider=Local
# Storage__S3__Bucket=mail-client-attachments
# Storage__S3__Region=eu-central-1
# Storage__S3__ServiceUrl=https://minio.internal:9000
# Storage__S3__ForcePathStyle=true
# Storage__S3__Prefix=production
# Storage__S3__AccessKeyId=change-me
# Storage__S3__SecretAccessKey=change-me
