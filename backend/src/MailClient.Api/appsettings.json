{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Directory": "logs",
      "RetainedFileCount": 14
    }
  },
  "HttpLogging": {
    "Enabled": true,
    "MaxRequestBodyBytes": 32768,
    "MaxResponseBodyBytes": 65536,
    "ExcludedPaths": ["/health", "/health/db", "/swagger", "/openapi"]
  },
  "AllowedHosts": "*",
  "Registration": {
    "Mode": "ApprovalRequired"
  },
  "Jwt": {
    "Issuer": "PostaKoprusu",
    "Audience": "PostaKoprusuClient",
    "Key": ""
  },
  "DataProtection": {
    "KeyPath": "data/protection-keys",
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "Firebase": {
    "Enabled": false,
    "ProjectId": "",
    "CredentialsPath": ""
  }
}
