{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=mailclient_v2;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "MailClient",
    "Audience": "MailClient",
    "Key": "development-only-key-change-before-production-123456789",
    "AccessTokenMinutes": 15
  },
  "Session": {
    "RefreshTokenLifetimeDays": 180,
    "SlidingExpiration": true
  },
  "HttpLogging": {
    "Enabled": true,
    "MaxRequestBodyBytes": 65536,
    "MaxResponseBodyBytes": 65536,
    "ExcludedPaths": ["/health", "/metrics", "/swagger"]
  },
  "Storage": {
    "Provider": "Local",
    "S3": {
      "Bucket": "",
      "ServiceUrl": "",
      "Region": "",
      "Prefix": "",
      "ForcePathStyle": false
    }
  },
  "Observability": {
    "ServiceName": "mail-client",
    "Tracing": { "Enabled": true },
    "Metrics": { "Enabled": true },
    "Otlp": { "Enabled": false, "Endpoint": "" },
    "Prometheus": { "Enabled": false },
    "Logs": {
      "App": { "RetainedFileCountLimit": 14, "FileSizeLimitBytes": 104857600 },
      "Http": { "RetainedFileCountLimit": 7, "FileSizeLimitBytes": 104857600 }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
